    const ctx = finalCanvas.getContext('2d');
    
    // Calculate total combined dimensions
    finalCanvas.width = 1500;
    finalCanvas.height = 1500;
    
    // row one
    ctx.drawImage(document.getElementById(canvasI), 0, 0);
    ctx.drawImage(document.getElementById(canvasII), 500, 0);
    ctx.drawImage(document.getElementById(canvasIII), 1000, 0);
    // row two
    ctx.drawImage(document.getElementById(canvasIV), 0, 500);
    ctx.drawImage(document.getElementById(canvasV), 500, 500);
    ctx.drawImage(document.getElementById(canvasVI), 1000, 500);
    // row three
    ctx.drawImage(document.getElementById(canvasVII), 0, 1000);
    ctx.drawImage(document.getElementById(canvasVIII), 500, 1000);
    ctx.drawImage(document.getElementById(canvasIX), 1000, 1000);



    return finalCanvas;
}


