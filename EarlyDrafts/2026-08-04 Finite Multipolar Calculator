function downloadCanvasAsJpeg(canvasId, fileName = 'cHex EXP s times '+theta+' .png', quality = 1) {
  // 1. Locate the canvas element
  const canvas = document.getElementById(canvasId);
  
  // 2. Convert canvas to a JPEG data URL (Quality ranges from 0.0 to 1.0)
  const dataUrl = canvas.toDataURL('image/png', quality);
  
  // 3. Create a temporary anchor element
  const link = document.createElement('a');
  
  // 4. Set the download attributes
  link.download = fileName;
  link.href = dataUrl;
  
  // 5. Trigger a virtual click to start the download
  link.click();
}


downloadCanvasAsJpeg("canvasMerged");

